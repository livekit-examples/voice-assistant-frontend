# LiveKit credentials from your project's Settings page in LiveKit Cloud (https://cloud.livekit.io).
# Leave blank to connect to the LiveKit homepage agent instead of your own.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=
